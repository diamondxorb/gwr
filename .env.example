# Copie este arquivo para .env (nunca versionado) e ajuste se necessário.
# cp .env.example .env

# --- PostGIS / docker-compose.yml ---
POSTGRES_USER=gwr_user
POSTGRES_PASSWORD=gwr_pass
POSTGRES_DB=gwr_imoveis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- pgAdmin (opcional, docker compose --profile tools up) ---
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Geocodificação (Epic 2, issue #10 em diante) ---
# User-Agent exigido pela política de uso do Nominatim/OSM (identifique seu projeto/e-mail)
NOMINATIM_USER_AGENT=gwr-precos-imoveis (seu-email@exemplo.com)
