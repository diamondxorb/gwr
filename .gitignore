# Segredos / ambiente
.env

# Ambientes virtuais
.venv/
venv/
env/

# Dados (geoespaciais tendem a ser grandes, e o King County não pode ser
# redistribuído fora do Kaggle) — mantemos só a estrutura de pastas (.gitkeep)
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Python
__pycache__/
*.pyc
*.egg-info/

# Editor / SO
.vscode/
.DS_Store
